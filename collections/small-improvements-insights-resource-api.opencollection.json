{
  "opencollection": "1.0.0",
  "info": {
    "name": "Small Improvements action-item-resource insights-resource API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "insights-resource",
        "type": "folder"
      },
      "items": [
